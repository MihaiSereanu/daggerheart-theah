<section class='tab {{tabs.settings.cssClass}}' data-tab='settings' data-group='primary'>
    <fieldset class="two-columns"><legend>Talent</legend>
        <span>Type</span>{{formInput systemFields.type value=source.system.type localize=true}}
        <span>Domain / Tradition</span>{{formInput systemFields.domain value=source.system.domain choices=domainChoices valueAttr="id" labelAttr="label" localize=true}}
        <span>Individually granted or borrowed</span>{{formInput systemFields.granted value=source.system.granted}}
    </fieldset>
    {{> "systems/daggerheart-theah/templates/sheets/global/partials/resource-section/resource-section.hbs" }}
</section>
